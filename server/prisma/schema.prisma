// Prisma schema базиран на Supabase структурата
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  admin
  realtor
  team_leader
  office_manager
  regional_manager
}

model Profile {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name") @db.Text
  email     String   @unique @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User?     @relation
  userRoles       UserRole[]
  realtor         Realtor?
  teams           Team[]    @relation("TeamLeader")
  managedOffices  Office[]  @relation("OfficeManager")
  managedCities   City[]    @relation("RegionalManager")
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  @@map("profiles")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.Text
  password  String   @db.Text
  profileId String   @unique @map("profile_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique @db.Text
  code      String   @unique @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cities City[]

  @@map("countries")
}

model City {
  id        String   @id @default(uuid())
  name      String   @db.Text
  countryId String   @map("country_id")
  managerId String?  @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  manager  Profile? @relation("RegionalManager", fields: [managerId], references: [id], onDelete: SetNull)
  offices  Office[]

  @@unique([name, countryId])
  @@map("cities")
}

model Office {
  id        String   @id @default(uuid())
  name      String   @db.Text
  cityId    String   @map("city_id")
  managerId String?  @map("manager_id")
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  manager Profile? @relation("OfficeManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams   Team[]

  @@unique([name, cityId])
  @@map("offices")
}

model Team {
  id        String    @id @default(uuid())
  name      String    @db.Text
  officeId  String    @map("office_id")
  leaderId  String?   @map("leader_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  office   Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  leader   Profile?  @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  realtors Realtor[]

  @@unique([name, officeId])
  @@map("teams")
}

model Realtor {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  teamId         String?  @map("team_id")
  level          Int      @default(1)
  hireDate       DateTime @default(now()) @map("hire_date") @db.Date
  confidence     Boolean  @default(false)
  salesResilience Boolean @default(false) @map("sales_resilience")
  successMindset Boolean  @default(false) @map("success_mindset")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  deals         Deal[]
  diagnoses     Diagnosis[]
  trainingProgress TrainingProgress[]
  goals         RealtorGoal[]
  buyerSchedule BuyerSchedule[]

  @@map("realtors")
}

model Deal {
  id         String   @id @default(uuid())
  realtorId  String   @map("realtor_id")
  clientName String   @map("client_name") @db.Text
  dealValue  Decimal  @map("deal_value") @db.Decimal(12, 2)
  commission Decimal? @db.Decimal(12, 2)
  dealDate   DateTime @default(now()) @map("deal_date") @db.Date
  isKey      Boolean  @default(false) @map("is_key")
  isExclusive Boolean @default(false) @map("is_exclusive")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  realtor Realtor @relation(fields: [realtorId], references: [id], onDelete: Cascade)

  @@map("deals")
}

model Diagnosis {
  id            String   @id @default(uuid())
  realtorId     String   @map("realtor_id")
  clientName    String   @map("client_name") @db.Text
  diagnosisDate DateTime @default(now()) @map("diagnosis_date") @db.Date
  status        String   @default("active") @db.Text
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  realtor Realtor @relation(fields: [realtorId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model TrainingProgress {
  id                String   @id @default(uuid())
  realtorId         String   @map("realtor_id")
  section           String   @db.Text
  subsection        String   @db.Text
  lectureCompleted  Boolean  @default(false) @map("lecture_completed")
  videoCompleted    Boolean  @default(false) @map("video_completed")
  practicalCompleted Boolean @default(false) @map("practical_completed")
  handoverCompleted Boolean  @default(false) @map("handover_completed")
  examCompleted     Boolean  @default(false) @map("exam_completed")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  realtor Realtor @relation(fields: [realtorId], references: [id], onDelete: Cascade)

  @@unique([realtorId, section, subsection], name: "realtor_section_subsection_unique")
  @@map("training_progress")
}

model RealtorGoal {
  id            String   @id @default(uuid())
  realtorId     String   @map("realtor_id")
  month         Int      @db.SmallInt
  year          Int      @db.SmallInt
  dealsGoal     Int      @default(0) @map("deals_goal")
  keysGoal      Int      @default(0) @map("keys_goal")
  exclusivesGoal Int     @default(0) @map("exclusives_goal")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  realtor Realtor @relation(fields: [realtorId], references: [id], onDelete: Cascade)

  @@unique([realtorId, month, year])
  @@map("realtor_goals")
}

model BuyerSchedule {
  id          String   @id @default(uuid())
  realtorId   String   @map("realtor_id")
  scheduleDate DateTime @map("schedule_date") @db.Date
  timeSlot    String   @map("time_slot") @db.Text
  buyer1Name  String?  @map("buyer1_name") @db.Text
  buyer1Phone String?  @map("buyer1_phone") @db.Text
  buyer1Notes String?  @map("buyer1_notes") @db.Text
  buyer2Name  String?  @map("buyer2_name") @db.Text
  buyer2Phone String?  @map("buyer2_phone") @db.Text
  buyer2Notes String?  @map("buyer2_notes") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  realtor Realtor @relation(fields: [realtorId], references: [id], onDelete: Cascade)

  @@map("buyer_schedule")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sender   Profile @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Profile @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, createdAt])
  @@map("messages")
}

